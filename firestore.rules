rules_version = '2';

// Data model (see src/firebase/firebase.js):
//   users/{uid}                          profile: displayName, color, avatar, email, isGuest
//   rounds/{roundId}                     createdBy, currentUsers[], contributors[], bpm, swing, name, ...
//   rounds/{roundId}/layers/{layerId}    createdBy + steps; only the creator edits a layer
//   rounds/{roundId}/userBuses/{uid}     one effects bus per user
//   rounds/{roundId}/userPatterns/{uid}  one preset/sequence document per user
//   samples/{sampleId}                   custom sample metadata, createdBy
//
// Anyone with a round's link can open it once signed in (guests sign in anonymously), which is
// the product's sharing model, so reads are gated on authentication rather than membership.
// Writes are always scoped to the caller's own documents, plus a round creator's right to
// manage everything inside their round (duplicate, delete).
//
// Test with the emulator before deploying: firebase emulators:start --only firestore

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function roundCreator(roundId) {
      return get(/databases/$(database)/documents/rounds/$(roundId)).data.createdBy;
    }

    function isRoundCreator(roundId) {
      return signedIn() && roundCreator(roundId) == request.auth.uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // What an update does to one of a round's lists of user ids. Both sets are empty when the
    // update leaves the list alone, and an empty set satisfies hasOnly().
    function addedTo(field) {
      return request.resource.data.get(field, []).toSet().difference(resource.data.get(field, []).toSet());
    }

    function removedFrom(field) {
      return resource.data.get(field, []).toSet().difference(request.resource.data.get(field, []).toSet());
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isUser(uid);
      allow delete: if false;
    }

    match /rounds/{roundId} {
      // Joining a round (adding yourself to both lists, or only to currentUsers, which is what a
      // client from before `contributors` writes) and leaving one (taking yourself out of
      // currentUsers), condition by condition:
      //   * nothing but the two membership lists may change: no editing the round in passing;
      //   * currentUsers may only gain the caller: nobody is dragged into a round by somebody else;
      //   * currentUsers may only lose the caller: nobody is thrown out of a round;
      //   * contributors may never lose anybody, whoever is writing;
      //   * contributors may only gain the caller, except for the one-off backfill of a round saved
      //     before the field existed, which writes everybody the round can be seen to have had.
      //     That write says nothing about the caller, so it is limited to a member or the creator
      //     (who may write the round anyway, by the creator and member clauses in `update` below:
      //     this spells the case out and keeps holding if those are ever tightened).
      function selfJoinOrLeave() {
        return changedKeys().hasOnly(['currentUsers', 'contributors']) &&
          addedTo('currentUsers').hasOnly([request.auth.uid]) &&
          removedFrom('currentUsers').hasOnly([request.auth.uid]) &&
          removedFrom('contributors').size() == 0 &&
          (addedTo('contributors').hasOnly([request.auth.uid]) ||
            request.auth.uid in resource.data.get('currentUsers', []) ||
            resource.data.createdBy == request.auth.uid);
      }

      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      // `currentUsers` is who is in the round right now; `contributors` is everyone who has ever
      // been in it. Nobody is ever taken out of `contributors`, because a layer is drawn in its
      // author's colour long after the author has left.
      //
      // The creator and the members edit the round. Everybody else may only join it or leave it,
      // and selfJoinOrLeave() says precisely what that means: an earlier rule let anyone signed in
      // write any `currentUsers` that had themselves in it, which was enough to throw every other
      // member out of somebody else's round.
      allow update: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.get('currentUsers', []) ||
        selfJoinOrLeave()
      );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /layers/{layerId} {
        allow read: if signedIn();
        // A layer belongs to whoever created it; the round creator may also create layers
        // (duplicating a round) and delete them (deleting a round).
        allow create: if signedIn() && (
          request.resource.data.createdBy == request.auth.uid || isRoundCreator(roundId)
        );
        allow update: if signedIn() && resource.data.createdBy == request.auth.uid;
        allow delete: if signedIn() && (
          resource.data.createdBy == request.auth.uid || isRoundCreator(roundId)
        );
      }

      match /userBuses/{uid} {
        allow read: if signedIn();
        allow write: if isUser(uid) || isRoundCreator(roundId);
      }

      match /userPatterns/{uid} {
        allow read: if signedIn();
        allow write: if isUser(uid) || isRoundCreator(roundId);
      }
    }

    match /samples/{sampleId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Everything else (including the unused `collaborations` collection) is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
